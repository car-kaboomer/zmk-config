 *
 * Metasepia2 (34 keys) Key Labels
 * ------------------------------------
 *     ╭─────────────────────┬─────────────────────╮
 *     │ LT4 LT3 LT2 LT1 LT0 │ RT0 RT1 RT2 RT3 RT4 │
 *     │ LM4 LM3 LM2 LM1 LM0 │ RM0 RM1 RM2 RM3 RM4 │
 *     │ LB4 LB3 LB2 LB1  LEN│REN  RB1 RB2 RB3 RB4 │
 *     ╰───────────╮ LH1 LH0 │ RH0 RH1 ╭───────────╯
 *                 ╰─────────┴─────────╯
 *
 */


#pragma once

